[Unit]
Description=성격 탐험 (학생용 간이 MBTI) 웹앱
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sihueng-mbti
Group=sihueng-mbti
WorkingDirectory=/opt/sihueng-mbti
EnvironmentFile=/etc/sihueng-mbti.env
ExecStart=__NODE__ /opt/sihueng-mbti/server.js
Restart=on-failure
RestartSec=3

# 보안: 이 앱은 파일을 쓰지 않으므로 시스템 전체를 읽기 전용으로 둡니다
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target

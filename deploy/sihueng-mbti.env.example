# 성격 탐험 서버 설정 — /etc/sihueng-mbti.env 로 복사해서 쓰세요 (권한 600 권장)

# 서버가 열 포트와 주소
PORT=8080
HOST=0.0.0.0

# Claude API 키 (비워 두면 AI 없이 기본 해설로 동작)
# 이 키는 서버에만 있고 브라우저로는 절대 전달되지 않아요.
ANTHROPIC_API_KEY=

# 학생 휴대폰이 접속할 주소. QR 코드에 이 주소가 들어가요.
# 예: https://mbti.school.example/   또는   http://192.168.0.10:8080/
# 비워 두면 선생님이 접속한 주소를 그대로 써요 (localhost로 접속하면 휴대폰에서 열 수 없어요).
PUBLIC_URL=

# 한 기기(IP)가 10분 동안 보낼 수 있는 AI 요청 수
RATE_LIMIT=30

# nginx 같은 리버스 프록시 뒤에서 실행할 때만 1
TRUST_PROXY=0
